{
  "Api": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ],
    "RateLimitPermitLimit": 300,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 10
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Construction.Api",
      "Audience": "Construction.Client",
      "SigningKey": "development-only-signing-key-change-before-use-2026",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Observability": {
    "ServiceName": "Construction.Api",
    "OtlpEndpoint": "",
    "TraceSamplingRatio": 1.0
  },
  "FileStorage": {
    "RootPath": "data/uploads",
    "MaximumFileSizeBytes": 104857600
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=construction;Username=construction;Password=construction"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
