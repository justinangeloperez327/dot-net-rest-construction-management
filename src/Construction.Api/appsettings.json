{
  "Api": {
    "AllowedOrigins": [],
    "RateLimitPermitLimit": 120,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Construction.Api",
      "Audience": "Construction.Client",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Observability": {
    "ServiceName": "Construction.Api",
    "OtlpEndpoint": "",
    "TraceSamplingRatio": 0.1
  },
  "FileStorage": {
    "RootPath": "data/uploads",
    "MaximumFileSizeBytes": 104857600
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
