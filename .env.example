# Container image produced by your build/release pipeline.
CONSTRUCTION_API_IMAGE=construction-api:latest

# PostgreSQL
POSTGRES_DB=construction
POSTGRES_USER=construction
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Authentication
# Use a high-entropy secret of at least 32 bytes.
JWT_SIGNING_KEY=replace-with-a-high-entropy-production-signing-key

# Public application origin and host validation.
ALLOWED_ORIGIN=https://construction.example.com
ALLOWED_HOSTS=api.construction.example.com

# Bind production Compose to loopback by default for a host reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# File storage
MAXIMUM_FILE_SIZE_BYTES=104857600

# OpenTelemetry
OTEL_SERVICE_NAME=Construction.Api
TRACE_SAMPLING_RATIO=0.1
# Optional. Leave empty unless an OTLP collector/endpoint is reachable.
OTLP_ENDPOINT=
